          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"duplicate@example.com\",\n  \"fullName\": \"Duplicate User\",\n  \"age\": 30,\n  \"country\": \"USA\",\n  \"bio\": \"Testing duplicate username\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/users",
              "protocol": "http",
              "host": ["localhost"],
