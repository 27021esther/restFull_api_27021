              "path": ["api", "users"]
            },
            "description": "Test case: Attempt to create user with existing username. Should return 409 Conflict."
          },
          "response": []
        },
        {
          "name": "Test: Get Non-Existent User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/users/999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "users", "999"]
            },
            "description": "Test case: Attempt to get user with non-existent ID. Should return 404 Not Found."
          },
          "response": []
        },
        {
          "name": "Test: Delete Non-Existent User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/users/999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "users", "999"]
            },
            "description": "Test case: Attempt to delete non-existent user. Should return 404 Not Found."
          },
          "response": []
        },
        {
          "name": "Test: Search with No Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/users/search?keyword=zzzzzzzzz",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "users", "search"],
              "query": [
                {
                  "key": "keyword",
                  "value": "zzzzzzzzz",
                  "description": "Keyword that won't match any users"
                }
              ]
            },
            "description": "Test case: Search with keyword that returns no results. Should return empty array."
          },
          "response": []
        }
      ],
      "description": "Test scenarios for error cases and edge cases"
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
